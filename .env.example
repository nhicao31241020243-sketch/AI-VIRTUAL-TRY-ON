# Sao chép thành .env.local (không commit file này). Không điền secret thật vào .env.example.

# Chỉ dùng phía server. Để trống => tự chạy demo mode. Lấy tại https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Model Replicate: "chu-so-huu/ten-model" hoặc "chu-so-huu/ten-model:<version-sha-64-ky-tu>".
# IDM-VTON chỉ được dùng phi thương mại.
REPLICATE_TRYON_MODEL=cuuupid/idm-vton

# true: không gọi Replicate, trả ảnh mẫu sau ~3 giây (khuyến nghị khi deploy thử).
NEXT_PUBLIC_DEMO_MODE=true

# true (mặc định): giới hạn 5 lượt/IP/giờ. false: tắt giới hạn (chỉ dùng khi phát triển).
TRYON_RATE_LIMIT_ENABLED=true
