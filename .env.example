# Sao chép thành .env.local (không commit file này). Không điền secret thật vào .env.example.

# Provider thử đồ: gemini hoặc huggingface
TRYON_PROVIDER=gemini

# Gemini API key, chỉ dùng phía server. Lấy tại https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Hugging Face token, chỉ dùng phía server. Space IDM-VTON: yisol/IDM-VTON
HF_TOKEN=

# true (mặc định): giới hạn 5 lượt/IP/giờ. false: tắt giới hạn (chỉ dùng khi phát triển).
TRYON_RATE_LIMIT_ENABLED=true

# Supabase server-only credentials for feedback and admin analytics.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin metrics password (at least 12 characters); never use a NEXT_PUBLIC_ variable.
ADMIN_METRICS_PASSWORD=

# Random server secret, at least 32 characters, signs anonymous analytics cookies.
ANALYTICS_SECRET=

# Development only: without Supabase, analytics persists in .data/analytics/data.json.
# ANALYTICS_LOCAL_DIR=.data/analytics
